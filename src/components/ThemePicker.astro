---
// TEMPORARY REVIEW TOOL.
//
// Renders every candidate palette as a CSS block and a floating picker so the
// options can be compared on the real page. Once a palette is confirmed, the
// winning values move into global.css as the single locked theme, and this
// component, src/data/palettes.ts and the picker markup all get deleted.
import { palettes } from "../data/palettes";

const varsFor = (set: Record<string, string>) => `
    --c-bg: ${set.bg};
    --c-surface: ${set.surface};
    --c-surface-2: ${set.surface2};
    --c-line: ${set.line};
    --c-line-strong: ${set.lineStrong};
    --c-text: ${set.text};
    --c-muted: ${set.muted};
    --c-accent: ${set.accent};
    --c-accent-soft: ${set.accent}1f;
    --c-accent-ink: ${set.accentInk};
    --c-spark: ${set.spark};
    --grid-line: ${set.gridLine};
    --glow: ${set.accent}14;`;

const css = palettes
  .map(
    (p) => `
  :root[data-palette="${p.id}"][data-theme="light"] {${varsFor(p.light)}
  }
  :root[data-palette="${p.id}"][data-theme="dark"] {${varsFor(p.dark)}
  }`,
  )
  .join("\n");
---

<style is:global set:html={css}></style>

<div
  id="palette-picker"
  class="fixed bottom-4 right-4 z-[70] font-mono text-[11px] print:hidden"
>
  <button
    id="palette-toggle"
    type="button"
    class="flex items-center gap-2 rounded-[4px] border border-line-strong bg-surface px-3 py-2 text-ink shadow-lg"
    aria-expanded="false"
    aria-controls="palette-panel"
  >
    <span class="size-2.5 rounded-full bg-accent"></span>
    Palette
  </button>

  <div
    id="palette-panel"
    hidden
    class="mt-2 w-[280px] rounded-[4px] border border-line-strong bg-surface p-3 shadow-2xl"
  >
    <p class="mb-3 text-[10px] uppercase tracking-[0.18em] text-muted">Review tool, not shipped</p>

    <div class="mb-3 flex gap-1.5">
      <button
        type="button"
        data-mode="light"
        class="flex-1 rounded-[4px] border border-line px-2 py-1.5 text-ink transition-colors hover:border-accent"
        >Light</button
      >
      <button
        type="button"
        data-mode="dark"
        class="flex-1 rounded-[4px] border border-line px-2 py-1.5 text-ink transition-colors hover:border-accent"
        >Dark</button
      >
    </div>

    <ul class="flex flex-col gap-1">
      {
        palettes.map((p) => (
          <li>
            <button
              type="button"
              data-palette={p.id}
              class="group flex w-full items-center gap-2.5 rounded-[4px] border border-transparent px-2 py-2 text-left transition-colors hover:border-line"
            >
              <span class="flex shrink-0 gap-1">
                <span
                  class="size-3.5 rounded-full border border-line"
                  style={`background:${p.dark.accent}`}
                />
                <span
                  class="size-3.5 rounded-full border border-line"
                  style={`background:${p.dark.spark}`}
                />
                <span
                  class="size-3.5 rounded-full border border-line"
                  style={`background:${p.dark.bg}`}
                />
              </span>
              <span class="min-w-0">
                <span class="block text-ink" data-name>
                  {p.name}
                </span>
                <span class="block truncate text-[10px] text-muted">{p.note}</span>
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<script>
  const root = document.documentElement;
  const picker = document.getElementById("palette-picker")!;
  const toggle = document.getElementById("palette-toggle")!;
  const panel = document.getElementById("palette-panel")!;

  const mark = () => {
    const current = root.getAttribute("data-palette");
    const mode = root.getAttribute("data-theme");
    picker.querySelectorAll<HTMLElement>("[data-palette]").forEach((b) => {
      const on = b.dataset.palette === current;
      b.classList.toggle("!border-accent", on);
      b.querySelector("[data-name]")?.classList.toggle("text-accent", on);
    });
    picker.querySelectorAll<HTMLElement>("[data-mode]").forEach((b) => {
      b.classList.toggle("!border-accent", b.dataset.mode === mode);
      b.classList.toggle("text-accent", b.dataset.mode === mode);
    });
  };

  toggle.addEventListener("click", () => {
    panel.hidden = !panel.hidden;
    toggle.setAttribute("aria-expanded", String(!panel.hidden));
  });

  picker.querySelectorAll<HTMLElement>("[data-palette]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = btn.dataset.palette!;
      root.setAttribute("data-palette", id);
      try {
        localStorage.setItem("tm-palette", id);
      } catch {
        /* storage blocked, choice still applies for this visit */
      }
      mark();
    });
  });

  picker.querySelectorAll<HTMLElement>("[data-mode]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const mode = btn.dataset.mode!;
      root.setAttribute("data-theme", mode);
      try {
        localStorage.setItem("tm-theme", mode);
      } catch {
        /* storage blocked */
      }
      mark();
    });
  });

  new MutationObserver(mark).observe(root, {
    attributes: true,
    attributeFilter: ["data-theme", "data-palette"],
  });
  mark();
</script>
