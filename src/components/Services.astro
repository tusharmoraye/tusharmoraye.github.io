---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import agentArt from "../assets/services/agent-node.jpg";
import speedArt from "../assets/services/perf-speed.jpg";
import meshArt from "../assets/services/infra-mesh.jpg";
---

<section id="capabilities" class="relative overflow-hidden border-t border-line py-20 md:py-28">
  <!-- Subtle background grid -->
  <div class="rule-grid pointer-events-none absolute inset-0 opacity-40" aria-hidden="true"></div>

  <div class="shell relative z-[2]">
    <!-- Section Header -->
    <div class="max-w-3xl">
      <div class="reveal mb-4 inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1 font-mono text-[11px] text-muted shadow-xs">
        <span class="size-1.5 rounded-full bg-accent animate-pulse"></span>
        <span>What I Do</span>
      </div>

      <h2 class="reveal font-display text-[clamp(2rem,3.8vw,3.2rem)] font-semibold leading-[1.08] tracking-[-0.03em]">
        Three pillars of production engineering.
      </h2>
      
      <p class="reveal mt-3 max-w-[56ch] text-sm leading-relaxed text-muted md:text-base" style="--reveal-delay:120ms">
        End-to-end engineering from conversational intelligence to sub-second user surfaces and distributed event backends.
      </p>
    </div>

    <!-- 3 Alternating Feature Rows with Zeni-Style Floating Interactive Widget Canvases -->
    <div class="mt-16 flex flex-col gap-20 lg:gap-32">
      
      <!-- ===================================================================
           PILLAR 1: INTELLIGENCE & AGENTS (Zeni-Style Copilot & Tool Canvas)
           =================================================================== -->
      <article class="pillar-row grid items-stretch gap-10 lg:grid-cols-12 lg:gap-14" data-pillar="ai">
        <!-- Content Column -->
        <div class="pillar-content flex min-w-0 flex-col lg:col-span-5 lg:justify-between">
          <div class="inline-flex items-center gap-2 font-mono text-[11px] font-semibold tracking-wider text-accent uppercase">
            <span class="flex size-2 rounded-full bg-accent animate-ping"></span>
            <span>01 / Intelligence &amp; Agents</span>
          </div>

          <h3 class="mt-2.5 font-display text-[clamp(1.5rem,2.5vw,2.2rem)] font-semibold leading-[1.15] tracking-[-0.025em] text-ink">
            Conversational copilots with tool orchestration.
          </h3>

          <p class="mt-3 text-sm leading-relaxed text-muted">
            Architecting production agentic workflows with streaming state, Model Context Protocol (MCP) tool routing, human-in-the-loop controls, and empirical eval assertions.
          </p>

          <ul class="mt-5 space-y-2.5 text-xs text-ink">
            <li class="flex items-center gap-2.5">
              <span class="flex size-4.5 shrink-0 items-center justify-center rounded-full bg-accent/15 text-accent">
                <Icon name="ph:check-bold" class="size-2.5" />
              </span>
              <span>Sub-200ms TTFT streaming state on Vercel <code class="font-mono text-[11px] text-accent">ai-sdk</code></span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="flex size-4.5 shrink-0 items-center justify-center rounded-full bg-accent/15 text-accent">
                <Icon name="ph:check-bold" class="size-2.5" />
              </span>
              <span>MCP tool routing with human-in-the-loop safeguards</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="flex size-4.5 shrink-0 items-center justify-center rounded-full bg-accent/15 text-accent">
                <Icon name="ph:check-bold" class="size-2.5" />
              </span>
              <span>84+ automated E2E eval test suites in CI release gates</span>
            </li>
          </ul>

          <div class="mt-6 flex flex-wrap gap-1.5 border-t border-line/60 pt-3.5">
            {["Vercel ai-sdk", "MCP Protocol", "RAG & Vectors", "LLM Evals", "Wasm ML"].map((tag) => (
              <span class="rounded-md border border-line bg-surface-2 px-2 py-0.5 font-mono text-[10px] text-muted">
                {tag}
              </span>
            ))}
          </div>
        </div>

        <!-- Visual Stage Column: Zeni-Style Multi-Widget Floating Stage -->
        <div class="pillar-stage-wrap flex min-w-0 lg:col-span-7">
          <div class="zeni-stage relative w-full min-h-[460px] sm:min-h-[480px] rounded-2xl border border-line/80 bg-surface/60 p-4 sm:p-6 shadow-2xl backdrop-blur-xl overflow-hidden" id="zeni-ai-stage">
            <!-- Generated art backdrop, masked back so the icon layer stays legible -->
            <Image
              src={agentArt}
              alt=""
              width={1024}
              height={1024}
              loading="lazy"
              decoding="async"
              class="stage-art pointer-events-none absolute left-1/2 top-1/2 size-[130%] max-w-none -translate-x-1/2 -translate-y-1/2 object-contain opacity-[0.30] [html[data-theme='light']_&]:opacity-[0.10]"
              aria-hidden="true"
            />
            <!-- Ambient glow -->
            <div class="pointer-events-none absolute -top-16 -right-16 size-80 rounded-full bg-accent/20 blur-3xl" aria-hidden="true"></div>
            <div class="pointer-events-none absolute -bottom-16 -left-16 size-72 rounded-full bg-spark/15 blur-3xl" aria-hidden="true"></div>

            <!-- Orbit rails. Geometry is measured from the DOM on load and on
                 resize, so the spokes always land dead centre on each node. -->
            <svg class="agent-wires pointer-events-none absolute inset-0 size-full" fill="none" aria-hidden="true">
              <circle class="orbit-rail" stroke="var(--c-accent)" stroke-opacity="0.34" stroke-width="1" stroke-dasharray="3 9" />
              <circle class="orbit-rail-inner" stroke="var(--c-accent)" stroke-opacity="0.24" stroke-width="1" stroke-dasharray="2 7" />
              <g class="agent-spokes" stroke="var(--c-accent)" stroke-opacity="0.55" stroke-width="1.25">
                <line class="spoke spoke-0" />
                <line class="spoke spoke-1" />
                <line class="spoke spoke-2" />
                <line class="spoke spoke-3" />
              </g>
              <circle class="agent-packet" r="4.5" fill="var(--c-accent)" opacity="0" />
            </svg>

            <!-- Core -->
            <div class="absolute left-1/2 top-1/2 z-20 -translate-x-1/2 -translate-y-1/2">
              <div class="relative grid size-20 place-items-center">
                <span class="agent-halo absolute inset-0 rounded-full border border-accent/50" aria-hidden="true"></span>
                <span class="agent-halo-2 absolute inset-0 rounded-full border border-accent/30" aria-hidden="true"></span>
                <span class="absolute inset-2 rounded-full bg-accent/15 blur-md" aria-hidden="true"></span>
                <span class="agent-core relative grid size-14 place-items-center rounded-full border border-accent/70 bg-bg shadow-xl">
                  <Icon name="ph:sparkle-fill" class="size-6 text-accent" />
                </span>
              </div>
            </div>

            <!-- Tool nodes -->
            <div class="agent-node absolute left-1/2 top-1/2 z-10 flex flex-col items-center -translate-x-1/2 -translate-y-1/2 -mt-[88px] sm:-mt-[150px]" data-depth="0.05" data-node="0">
              <div class="node-chip grid size-14 place-items-center rounded-2xl border border-line-strong bg-bg shadow-lg">
                <Icon name="ph:database-bold" class="node-icon size-6 text-muted" />
              </div>
              <p class="mt-2 text-center font-mono text-[9px] uppercase tracking-wider text-muted">retrieve</p>
            </div>

            <div class="agent-node absolute left-1/2 top-1/2 z-10 flex flex-col items-center -translate-x-1/2 -translate-y-1/2 ml-[88px] sm:ml-[150px]" data-depth="0.05" data-node="1">
              <div class="node-chip grid size-14 place-items-center rounded-2xl border border-line-strong bg-bg shadow-lg">
                <Icon name="ph:function-bold" class="node-icon size-6 text-muted" />
              </div>
              <p class="mt-2 text-center font-mono text-[9px] uppercase tracking-wider text-muted">tool call</p>
            </div>

            <div class="agent-node absolute left-1/2 top-1/2 z-10 flex flex-col items-center -translate-x-1/2 -translate-y-1/2 mt-[88px] sm:mt-[150px]" data-depth="0.05" data-node="2">
              <div class="node-chip grid size-14 place-items-center rounded-2xl border border-line-strong bg-bg shadow-lg">
                <Icon name="ph:shield-check-bold" class="node-icon size-6 text-muted" />
              </div>
              <p class="mt-2 text-center font-mono text-[9px] uppercase tracking-wider text-muted">guardrail</p>
            </div>

            <div class="agent-node absolute left-1/2 top-1/2 z-10 flex flex-col items-center -translate-x-1/2 -translate-y-1/2 -ml-[88px] sm:-ml-[150px]" data-depth="0.05" data-node="3">
              <div class="node-chip grid size-14 place-items-center rounded-2xl border border-line-strong bg-bg shadow-lg">
                <Icon name="ph:chart-line-bold" class="node-icon size-6 text-muted" />
              </div>
              <p class="mt-2 text-center font-mono text-[9px] uppercase tracking-wider text-muted">stream</p>
            </div>

            <!-- Corner status -->
            <div class="pointer-events-none absolute bottom-4 left-4 flex items-center gap-1.5 font-mono text-[9px] text-muted">
              <Icon name="ph:check-bold" class="agent-tick size-3 text-ok" />
              <span class="agent-tick-label">84/84 evals</span>
            </div>
          </div>
        </div>
      </article>


      <!-- ===================================================================
           PILLAR 2: EXPERIENCE & CRAFT (Zeni-Style Speed & Physics Canvas)
           =================================================================== -->
      <article class="pillar-row grid items-stretch gap-10 lg:grid-cols-12 lg:gap-14" data-pillar="web">
        <!-- Visual Stage Column (Left on Desktop) -->
        <div class="pillar-stage-wrap order-2 flex lg:order-1 min-w-0 lg:col-span-7">
          <div class="zeni-stage relative w-full min-h-[460px] sm:min-h-[480px] rounded-2xl border border-line/80 bg-surface/60 p-4 sm:p-6 shadow-2xl backdrop-blur-xl overflow-hidden" id="zeni-perf-stage">
            <!-- Generated art backdrop, masked back so the icon layer stays legible -->
            <Image
              src={speedArt}
              alt=""
              width={1024}
              height={1024}
              loading="lazy"
              decoding="async"
              class="stage-art pointer-events-none absolute left-1/2 top-1/2 size-[130%] max-w-none -translate-x-1/2 -translate-y-1/2 object-contain opacity-[0.30] [html[data-theme='light']_&]:opacity-[0.10]"
              aria-hidden="true"
            />
            <!-- Ambient glow -->
            <div class="pointer-events-none absolute -bottom-16 -left-16 size-80 rounded-full bg-spark/20 blur-3xl" aria-hidden="true"></div>
            <div class="pointer-events-none absolute -top-16 -right-16 size-72 rounded-full bg-accent/15 blur-3xl" aria-hidden="true"></div>

            <div class="relative z-10 flex h-full flex-col items-center justify-center gap-8">
              <!-- Speed dial -->
              <div class="zeni-widget relative grid place-items-center rounded-2xl border border-line/80 bg-bg/70 p-3 shadow-lg backdrop-blur-md" data-depth="0.05">
                <svg class="size-44 sm:size-48 -rotate-90" viewBox="0 0 120 120" fill="none" aria-hidden="true">
                  <circle cx="60" cy="60" r="52" stroke="var(--c-line)" stroke-width="6" opacity="0.5" />
                  <circle
                    class="speed-arc"
                    cx="60" cy="60" r="52"
                    stroke="var(--c-accent)" stroke-width="6" stroke-linecap="round"
                    stroke-dasharray="327" stroke-dashoffset="327"
                  />
                </svg>
                <div class="absolute grid place-items-center">
                  <Icon name="ph:lightning-fill" class="speed-bolt size-6 text-spark" />
                  <p class="speed-value mt-1 font-mono text-3xl font-bold tracking-tight text-ink">0.0s</p>
                  <p class="font-mono text-[9px] uppercase tracking-[0.2em] text-muted">lcp</p>
                </div>
              </div>

              <!-- Paint blocks -->
              <div class="zeni-widget w-[76%] rounded-xl border border-line/90 bg-bg/95 p-4 shadow-xl" data-depth="0.03">
                <div class="flex items-center gap-1.5">
                  <span class="size-1.5 rounded-full bg-line"></span>
                  <span class="size-1.5 rounded-full bg-line"></span>
                  <span class="size-1.5 rounded-full bg-line"></span>
                  <Icon name="ph:browsers-bold" class="ml-auto size-3.5 text-muted" />
                </div>
                <div class="mt-3 grid grid-cols-6 gap-2">
                  <div class="paint-block col-span-6 h-7 origin-left rounded-md bg-accent/25"></div>
                  <div class="paint-block col-span-4 h-4 origin-left rounded-md bg-line"></div>
                  <div class="paint-block col-span-2 h-4 origin-left rounded-md bg-line"></div>
                  <div class="paint-block col-span-2 h-12 origin-left rounded-md bg-spark/25"></div>
                  <div class="paint-block col-span-2 h-12 origin-left rounded-md bg-line"></div>
                  <div class="paint-block col-span-2 h-12 origin-left rounded-md bg-line"></div>
                </div>
              </div>

              <!-- Shift meter -->
              <div class="flex items-center gap-2 font-mono text-[9px] uppercase tracking-wider text-muted">
                <Icon name="ph:check-bold" class="size-3 text-ok" />
                <span>zero layout shift</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Content Column -->
        <div class="pillar-content order-1 flex min-w-0 flex-col lg:order-2 lg:col-span-5 lg:justify-between">
          <div class="inline-flex items-center gap-2 font-mono text-[11px] font-semibold tracking-wider text-accent uppercase">
            <span class="flex size-2 rounded-full bg-spark animate-ping"></span>
            <span>02 / Experience &amp; Craft</span>
          </div>

          <h3 class="mt-2.5 font-display text-[clamp(1.5rem,2.5vw,2.2rem)] font-semibold leading-[1.15] tracking-[-0.025em] text-ink">
            Sub-second speed meets bespoke interface craft.
          </h3>

          <p class="mt-3 text-sm leading-relaxed text-muted">
            Crafting fast, accessible web surfaces with sub-second LCP and near-zero INP. Built with scalable design token systems, expressive GSAP physics, and zero layout shift.
          </p>

          <ul class="mt-5 space-y-2.5 text-xs text-ink">
            <li class="flex items-center gap-2.5">
              <span class="flex size-4.5 shrink-0 items-center justify-center rounded-full bg-accent/15 text-accent">
                <Icon name="ph:check-bold" class="size-2.5" />
              </span>
              <span>0.58s LCP &amp; 32ms INP across millions of user visits</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="flex size-4.5 shrink-0 items-center justify-center rounded-full bg-accent/15 text-accent">
                <Icon name="ph:check-bold" class="size-2.5" />
              </span>
              <span>Tokenized design systems with seamless dark/light modes</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="flex size-4.5 shrink-0 items-center justify-center rounded-full bg-accent/15 text-accent">
                <Icon name="ph:check-bold" class="size-2.5" />
              </span>
              <span>Expressive GSAP physics &amp; fluid micro-interactions</span>
            </li>
          </ul>

          <div class="mt-6 flex flex-wrap gap-1.5 border-t border-line/60 pt-3.5">
            {["Core Web Vitals", "GSAP Physics", "Design Tokens", "Astro & Next.js", "Lighthouse 100"].map((tag) => (
              <span class="rounded-md border border-line bg-surface-2 px-2 py-0.5 font-mono text-[10px] text-muted">
                {tag}
              </span>
            ))}
          </div>
        </div>
      </article>


      <!-- ===================================================================
           PILLAR 3: PLATFORM & INFRASTRUCTURE (Zeni-Style Event Mesh Canvas)
           =================================================================== -->
      <article class="pillar-row grid items-stretch gap-10 lg:grid-cols-12 lg:gap-14" data-pillar="fullstack">
        <!-- Content Column -->
        <div class="pillar-content flex min-w-0 flex-col lg:col-span-5 lg:justify-between">
          <div class="inline-flex items-center gap-2 font-mono text-[11px] font-semibold tracking-wider text-accent uppercase">
            <span class="flex size-2 rounded-full bg-ok animate-ping"></span>
            <span>03 / Platform &amp; Infrastructure</span>
          </div>

          <h3 class="mt-2.5 font-display text-[clamp(1.5rem,2.5vw,2.2rem)] font-semibold leading-[1.15] tracking-[-0.025em] text-ink">
            Event-driven backends engineered for scale.
          </h3>

          <p class="mt-3 text-sm leading-relaxed text-muted">
            Engineering high-throughput distributed backends and cloud infrastructure. Kafka event pipelines, Redis caching topologies, Kubernetes orchestration, and resilient APIs.
          </p>

          <ul class="mt-5 space-y-2.5 text-xs text-ink">
            <li class="flex items-center gap-2.5">
              <span class="flex size-4.5 shrink-0 items-center justify-center rounded-full bg-accent/15 text-accent">
                <Icon name="ph:check-bold" class="size-2.5" />
              </span>
              <span>Kafka streaming processing 45,000+ events/second</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="flex size-4.5 shrink-0 items-center justify-center rounded-full bg-accent/15 text-accent">
                <Icon name="ph:check-bold" class="size-2.5" />
              </span>
              <span>Redis distributed multi-tier cache with 99.8% hit rate</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="flex size-4.5 shrink-0 items-center justify-center rounded-full bg-accent/15 text-accent">
                <Icon name="ph:check-bold" class="size-2.5" />
              </span>
              <span>Kubernetes auto-scaling clusters with 99.99% SLA</span>
            </li>
          </ul>

          <div class="mt-6 flex flex-wrap gap-1.5 border-t border-line/60 pt-3.5">
            {["Apache Kafka", "Redis Cache", "Kubernetes", "Node.js & Go", "Zero-Downtime"].map((tag) => (
              <span class="rounded-md border border-line bg-surface-2 px-2 py-0.5 font-mono text-[10px] text-muted">
                {tag}
              </span>
            ))}
          </div>
        </div>

        <!-- Visual Stage Column: Zeni-Style Multi-Widget Floating Stage -->
        <div class="pillar-stage-wrap flex min-w-0 lg:col-span-7">
          <div class="zeni-stage relative w-full min-h-[460px] sm:min-h-[480px] rounded-2xl border border-line/80 bg-surface/60 p-4 sm:p-6 shadow-2xl backdrop-blur-xl overflow-hidden" id="zeni-infra-stage">
            <!-- Generated art backdrop, masked back so the icon layer stays legible -->
            <Image
              src={meshArt}
              alt=""
              width={1024}
              height={1024}
              loading="lazy"
              decoding="async"
              class="stage-art pointer-events-none absolute left-1/2 top-1/2 size-[130%] max-w-none -translate-x-1/2 -translate-y-1/2 object-contain opacity-[0.20] [html[data-theme='light']_&]:opacity-[0.07]"
              aria-hidden="true"
            />
            <!-- Ambient glow -->
            <div class="pointer-events-none absolute -top-16 -left-16 size-80 rounded-full bg-ok/20 blur-3xl" aria-hidden="true"></div>
            <div class="pointer-events-none absolute -bottom-16 -right-16 size-72 rounded-full bg-accent/15 blur-3xl" aria-hidden="true"></div>

            <!-- Pipeline rails, measured from the DOM like the agent wires. -->
            <svg class="infra-wires pointer-events-none absolute inset-0 size-full" fill="none" aria-hidden="true">
              <g class="infra-rails" stroke="var(--c-accent)" stroke-opacity="0.6" stroke-width="1.5" stroke-dasharray="4 6">
                <path class="infra-rail rail-in" />
                <path class="infra-rail rail-0" />
                <path class="infra-rail rail-1" />
                <path class="infra-rail rail-2" />
              </g>
              <circle class="infra-packet infra-packet-a" r="4" fill="var(--c-accent)" opacity="0" />
              <circle class="infra-packet infra-packet-b" r="4" fill="var(--c-spark)" opacity="0" />
              <circle class="infra-packet infra-packet-c" r="4" fill="var(--c-ok)" opacity="0" />
            </svg>

            <!-- Ingress -->
            <div class="absolute left-[10%] top-1/2 z-10 -translate-y-1/2 text-center">
              <div class="infra-ingress grid size-14 place-items-center rounded-2xl border border-line-strong bg-bg shadow-lg">
                <Icon name="ph:globe-hemisphere-west-bold" class="size-6 text-muted" />
              </div>
              <p class="mt-2 font-mono text-[9px] uppercase tracking-wider text-muted">ingress</p>
            </div>

            <!-- Event bus -->
            <div class="absolute left-1/2 top-1/2 z-20 -translate-x-1/2 -translate-y-1/2 text-center">
              <div class="infra-bus relative grid size-16 place-items-center rounded-2xl border border-accent/70 bg-bg shadow-xl">
                <span class="bus-halo absolute inset-0 rounded-2xl border border-accent/40" aria-hidden="true"></span>
                <Icon name="ph:queue-bold" class="size-7 text-accent" />
              </div>
              <p class="mt-2 font-mono text-[9px] uppercase tracking-wider text-muted">event bus</p>
            </div>

            <!-- Workers -->
            <div class="absolute right-[16%] top-[28%] z-10 text-center">
              <div class="worker-pod grid size-12 place-items-center rounded-xl border border-line-strong bg-bg shadow-lg">
                <Icon name="ph:cube-bold" class="size-5 text-muted" />
              </div>
            </div>
            <div class="absolute right-[16%] top-1/2 z-10 -translate-y-1/2 text-center">
              <div class="worker-pod grid size-12 place-items-center rounded-xl border border-line-strong bg-bg shadow-lg">
                <Icon name="ph:cube-bold" class="size-5 text-muted" />
              </div>
            </div>
            <div class="absolute right-[16%] top-[72%] z-10 -translate-y-1/2 text-center">
              <div class="worker-pod grid size-12 place-items-center rounded-xl border border-line-strong bg-bg shadow-lg">
                <Icon name="ph:cube-bold" class="size-5 text-muted" />
              </div>
            </div>

            <!-- Autoscaled pod -->
            <div class="absolute right-[3%] top-1/2 z-10 -translate-y-1/2 text-center">
              <div class="scale-pod grid size-12 place-items-center rounded-xl border border-dashed border-ok/70 bg-bg/95 shadow-lg opacity-0">
                <Icon name="ph:cube-bold" class="size-5 text-ok" />
              </div>
            </div>

            <p class="pointer-events-none absolute right-[6%] bottom-6 font-mono text-[9px] uppercase tracking-wider text-muted">autoscale</p>

            <div class="pointer-events-none absolute bottom-4 left-4 flex items-center gap-1.5 font-mono text-[9px] text-muted">
              <span class="size-1.5 rounded-full bg-ok animate-pulse"></span>
              <span>20M events / day</span>
            </div>
          </div>
        </div>
      </article>

    </div>
  </div>
</section>

<!-- GSAP Floating Physics & Multi-Layer Parallax Choreography -->
<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (!reduce.matches) {
    // 1. Entrance choreography for the 3 rows
    const rows = gsap.utils.toArray<HTMLElement>(".pillar-row");
    rows.forEach((row, i) => {
      const content = row.querySelector(".pillar-content");
      const stage = row.querySelector(".pillar-stage-wrap");
      const isEven = i % 2 === 1;

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: row,
          start: "top 80%",
          toggleActions: "play none none reverse",
        },
      });

      const isDesktop = window.innerWidth >= 1024;

      tl.from(content, {
        x: isDesktop ? (isEven ? 35 : -35) : 0,
        y: isDesktop ? 0 : 20,
        opacity: 0,
        duration: 0.8,
        ease: "power3.out",
      }).from(
        stage,
        {
          scale: 0.96,
          y: 25,
          opacity: 0,
          duration: 0.85,
          ease: "power3.out",
        },
        "-=0.5"
      );
    });

    // =========================================================================
    // 2. Organic Floating / Bobbing Physics for all Zeni Widgets
    // =========================================================================
    const stages = document.querySelectorAll<HTMLElement>(".zeni-stage");
    stages.forEach((stage) => {
      const widgets = stage.querySelectorAll<HTMLElement>(".zeni-widget");
      widgets.forEach((w, idx) => {
        const floatDistance = 5 + (idx % 3) * 2.5;
        const duration = 3.2 + (idx % 4) * 0.6;
        const delay = idx * 0.35;

        gsap.to(w, {
          y: `-=${floatDistance}`,
          duration: duration,
          delay: delay,
          repeat: -1,
          yoyo: true,
          ease: "sine.inOut",
        });
      });

      // 3D Parallax Tilt with multi-depth layers
      stage.addEventListener("pointermove", (e) => {
        if (window.innerWidth < 1024) return;
        const rect = stage.getBoundingClientRect();
        const mouseX = (e.clientX - rect.left) / rect.width - 0.5;
        const mouseY = (e.clientY - rect.top) / rect.height - 0.5;

        // Parallax depth movement on widgets
        widgets.forEach((w) => {
          const depth = parseFloat(w.getAttribute("data-depth") || "0.05");
          gsap.to(w, {
            x: mouseX * depth * 220,
            y: mouseY * depth * 220,
            duration: 0.4,
            ease: "power1.out",
            overwrite: "auto",
          });
        });
      });

      stage.addEventListener("pointerleave", () => {
        widgets.forEach((w) => {
          gsap.to(w, {
            x: 0,
            y: 0,
            duration: 0.6,
            ease: "power2.out",
            overwrite: "auto",
          });
        });
      });
    });

    // =========================================================================
    // =========================================================================
    // 3. Scene loops: one timeline per pillar, icon-led, no chrome to read
    // =========================================================================

    // --- 01 Intelligence: the core dispatches to each tool and gets a result
    const aiStage = document.getElementById("zeni-ai-stage");
    if (aiStage) {
      const svg = aiStage.querySelector<SVGSVGElement>(".agent-wires");
      const packet = aiStage.querySelector<SVGCircleElement>(".agent-packet");
      const core = aiStage.querySelector<HTMLElement>(".agent-core");
      const nodes = gsap.utils.toArray<HTMLElement>(".agent-node", aiStage);
      const spokes = gsap.utils.toArray<SVGLineElement>(".spoke", aiStage);
      const rails = gsap.utils.toArray<SVGCircleElement>(".orbit-rail, .orbit-rail-inner", aiStage);
      const tick = aiStage.querySelector<HTMLElement>(".agent-tick");
      const tickLabel = aiStage.querySelector<HTMLElement>(".agent-tick-label");

      // Rect-based, so the -50%/-50% centring transforms are accounted for.
      // Safe now that these nodes no longer carry the floating tween.
      const centreOf = (el: Element) => {
        const stageBox = aiStage.getBoundingClientRect();
        const box = el.getBoundingClientRect();
        return {
          x: box.left - stageBox.left + box.width / 2,
          y: box.top - stageBox.top + box.height / 2,
        };
      };

      let hub = { x: 0, y: 0 };
      let targets: { x: number; y: number }[] = [];
      let loop: gsap.core.Timeline | null = null;

      // The SVG shares the stage's pixel grid, so every wire can be pinned to a
      // measured node centre instead of a guessed viewBox coordinate.
      const layoutWires = () => {
        const w = aiStage.clientWidth;
        const h = aiStage.clientHeight;
        svg?.setAttribute("viewBox", `0 0 ${w} ${h}`);

        hub = centreOf(core!);
        targets = nodes.map((n) => centreOf(n.querySelector(".node-chip")!));

        const radius = Math.round(
          targets.reduce((acc, t) => acc + Math.hypot(t.x - hub.x, t.y - hub.y), 0) / targets.length,
        );
        rails[0]?.setAttribute("cx", `${hub.x}`);
        rails[0]?.setAttribute("cy", `${hub.y}`);
        rails[0]?.setAttribute("r", `${radius}`);
        rails[1]?.setAttribute("cx", `${hub.x}`);
        rails[1]?.setAttribute("cy", `${hub.y}`);
        rails[1]?.setAttribute("r", `${Math.round(radius * 0.62)}`);

        spokes.forEach((line, i) => {
          const t = targets[i];
          if (!t) return;
          line.setAttribute("x1", `${hub.x}`);
          line.setAttribute("y1", `${hub.y}`);
          line.setAttribute("x2", `${t.x}`);
          line.setAttribute("y2", `${t.y}`);
        });

        gsap.set(packet, { attr: { cx: hub.x, cy: hub.y } });
      };

      const buildLoop = () => {
        loop?.kill();
        loop = gsap.timeline({ repeat: -1 });

        targets.forEach((t, i) => {
          const chip = nodes[i]?.querySelector(".node-chip");
          const icon = nodes[i]?.querySelector(".node-icon");

          loop!
            .set(packet, { attr: { cx: hub.x, cy: hub.y }, opacity: 1 })
            .to(spokes[i], { attr: { "stroke-opacity": 0.9 }, duration: 0.2 }, "<")
            .to(packet, { attr: { cx: t.x, cy: t.y }, duration: 0.45, ease: "power2.inOut" })
            .to(chip, { borderColor: "var(--c-accent)", scale: 1.12, duration: 0.25, ease: "back.out(2)" }, "-=0.12")
            .to(icon, { color: "var(--c-accent)", duration: 0.25 }, "<")
            .to(packet, { attr: { cx: hub.x, cy: hub.y }, duration: 0.4, ease: "power2.inOut" }, "+=0.25")
            .to(core, { scale: 1.12, duration: 0.18, ease: "power2.out" }, "-=0.12")
            .to(core, { scale: 1, duration: 0.3, ease: "elastic.out(1, 0.5)" })
            .to(packet, { opacity: 0, duration: 0.15 }, "<")
            .to(chip, { borderColor: "var(--c-line)", scale: 1, duration: 0.35 }, "<")
            .to(icon, { color: "var(--c-muted)", duration: 0.35 }, "<")
            .to(spokes[i], { attr: { "stroke-opacity": 0.55 }, duration: 0.3 }, "<");
        });

        loop
          .to([tick, tickLabel], { scale: 1.25, color: "var(--c-ok)", duration: 0.2, ease: "back.out(3)" })
          .to([tick, tickLabel], { scale: 1, duration: 0.4 })
          .to({}, { duration: 0.8 });
      };

      layoutWires();
      buildLoop();
      // The row entrance tween offsets the stage; re-measure once it lands.
      window.setTimeout(() => {
        layoutWires();
        buildLoop();
      }, 1200);

      let resizeTimer: number;
      window.addEventListener("resize", () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => {
          layoutWires();
          buildLoop();
        }, 180);
      });

      // Art backdrop breathes so the scene never sits perfectly still.
      gsap.to(".stage-art", {
        scale: 1.06, duration: 9, repeat: -1, yoyo: true, ease: "sine.inOut", stagger: 1.5,
      });

      // Rails drift in opposite directions so the ring never reads as static.
      gsap.to(rails[0], { rotation: 360, duration: 46, repeat: -1, ease: "none", transformOrigin: "50% 50%" });
      gsap.to(rails[1], { rotation: -360, duration: 34, repeat: -1, ease: "none", transformOrigin: "50% 50%" });

      gsap.to(".agent-halo", {
        scale: 1.5, opacity: 0, duration: 2.4, repeat: -1, ease: "power2.out", transformOrigin: "50% 50%",
      });
      gsap.to(".agent-halo-2", {
        scale: 1.5, opacity: 0, duration: 2.4, delay: 1.2, repeat: -1, ease: "power2.out", transformOrigin: "50% 50%",
      });
    }

    // --- 02 Experience: the page paints, the dial settles on a fast LCP
    const perfStage = document.getElementById("zeni-perf-stage");
    if (perfStage) {
      const arc = perfStage.querySelector<SVGCircleElement>(".speed-arc");
      const value = perfStage.querySelector<HTMLElement>(".speed-value");
      const blocks = gsap.utils.toArray<HTMLElement>(".paint-block", perfStage);
      const counter = { v: 2.6 };

      gsap.set(blocks, { scaleX: 0, opacity: 0.35 });

      const loop = gsap.timeline({ repeat: -1, repeatDelay: 0 });

      loop
        .to(counter, {
          v: 0.4,
          duration: 1.5,
          ease: "power3.out",
          onUpdate: () => {
            if (value) value.textContent = `${counter.v.toFixed(1)}s`;
          },
        })
        // 327 is the full circumference; 0.4s of a 2.6s budget leaves it near full.
        .to(arc, { attr: { "stroke-dashoffset": 62 }, duration: 1.5, ease: "power3.out" }, "<")
        .to(blocks, { scaleX: 1, opacity: 1, duration: 0.4, stagger: 0.09, ease: "power2.out" }, 0.25)
        .to(".speed-bolt", { scale: 1.4, duration: 0.2, ease: "back.out(3)" }, "-=0.5")
        .to(".speed-bolt", { scale: 1, duration: 0.35 })
        // hold the finished, painted state - this is what the eye rests on
        .to({}, { duration: 3.4 })
        // reset for the next pass
        .to(blocks, { scaleX: 0, opacity: 0.35, duration: 0.25, stagger: 0.02 })
        .to(arc, { attr: { "stroke-dashoffset": 327 }, duration: 0.3 }, "<")
        .to(counter, {
          v: 2.6,
          duration: 0.3,
          onUpdate: () => {
            if (value) value.textContent = `${counter.v.toFixed(1)}s`;
          },
        }, "<");
    }

    // --- 03 Services: events flow through the bus and fan out to workers
    const infraStage = document.getElementById("zeni-infra-stage");
    if (infraStage) {
      const svg = infraStage.querySelector<SVGSVGElement>(".infra-wires");
      const ingress = infraStage.querySelector<HTMLElement>(".infra-ingress");
      const bus = infraStage.querySelector<HTMLElement>(".infra-bus");
      const pods = gsap.utils.toArray<HTMLElement>(".worker-pod", infraStage);
      const scalePod = infraStage.querySelector<HTMLElement>(".scale-pod");
      const railIn = infraStage.querySelector<SVGPathElement>(".rail-in");
      const railsOut = gsap.utils.toArray<SVGPathElement>(".rail-0, .rail-1, .rail-2", infraStage);

      const centreOf = (el: Element) => {
        const stageBox = infraStage.getBoundingClientRect();
        const box = el.getBoundingClientRect();
        return {
          x: box.left - stageBox.left + box.width / 2,
          y: box.top - stageBox.top + box.height / 2,
        };
      };

      let start = { x: 0, y: 0 };
      let hub = { x: 0, y: 0 };
      let ends: { x: number; y: number }[] = [];
      let loop: gsap.core.Timeline | null = null;

      const layoutWires = () => {
        svg?.setAttribute("viewBox", `0 0 ${infraStage.clientWidth} ${infraStage.clientHeight}`);

        start = centreOf(ingress!);
        hub = centreOf(bus!);
        ends = pods.map((pod) => centreOf(pod));

        railIn?.setAttribute("d", `M${start.x} ${start.y} H ${hub.x}`);
        railsOut.forEach((rail, i) => {
          const e = ends[i];
          if (!e) return;
          // Ease out of the hub horizontally before bending toward the pod.
          const bend = (e.x - hub.x) * 0.55;
          rail.setAttribute(
            "d",
            `M${hub.x} ${hub.y} C ${hub.x + bend} ${hub.y} ${e.x - bend} ${e.y} ${e.x} ${e.y}`,
          );
        });
      };

      const buildLoop = () => {
        loop?.kill();
        loop = gsap.timeline({ repeat: -1 });

        const legs = [".infra-packet-a", ".infra-packet-b", ".infra-packet-c"];

        legs.forEach((sel, i) => {
          const at = i * 0.75;
          const e = ends[i];
          if (!e) return;

          loop!
            .set(sel, { attr: { cx: start.x, cy: start.y }, opacity: 1 }, at)
            .to(sel, { attr: { cx: hub.x, cy: hub.y }, duration: 0.5, ease: "none" }, at)
            .to(".bus-halo", { scale: 1.2, duration: 0.15, ease: "power2.out" }, at + 0.5)
            .to(sel, { attr: { cx: e.x, cy: e.y }, duration: 0.5, ease: "none" }, at + 0.55)
            .to(pods[i], { borderColor: "var(--c-accent)", scale: 1.12, duration: 0.2 }, at + 1.0)
            .to(sel, { opacity: 0, duration: 0.2 }, at + 1.05)
            .to(pods[i], { borderColor: "var(--c-line)", scale: 1, duration: 0.4 }, at + 1.25);
        });

        // Load spikes, a fourth pod spins up, load drains, it retires.
        loop
          .fromTo(scalePod, { scale: 0.6 }, { opacity: 1, scale: 1, duration: 0.4, ease: "back.out(2)" }, 2.6)
          .to(scalePod, { opacity: 0, scale: 0.8, duration: 0.4 }, 4.4)
          .to({}, { duration: 0.6 });
      };

      layoutWires();
      buildLoop();
      // The row entrance tween offsets the stage; re-measure once it lands.
      window.setTimeout(() => {
        layoutWires();
        buildLoop();
      }, 1200);

      let resizeTimer: number;
      window.addEventListener("resize", () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => {
          layoutWires();
          buildLoop();
        }, 180);
      });

      gsap.to(".bus-halo", {
        scale: 1.45, opacity: 0, duration: 2, repeat: -1, ease: "power2.out", transformOrigin: "50% 50%",
      });
    }

  }
</script>

<style>
  .zeni-stage {
    perspective: 1200px;
    transform-style: preserve-3d;
  }

  /* Feather the art so its square edge never reads as a second frame inside
     the stage - most visible in light mode, where the dark render has hard
     corners against a near-white surface. */
  .stage-art {
    -webkit-mask-image: radial-gradient(circle at 50% 50%, #000 38%, transparent 70%);
    mask-image: radial-gradient(circle at 50% 50%, #000 38%, transparent 70%);
  }

  /* The renders are dark-on-black. Dropped straight onto the light surface they
     sit there as a grey slab that fights the card. Inverting turns the artwork
     light-on-white, and multiply then drops the white away, so only the line
     work is left as ink on the card. */
  :global(html[data-theme="light"]) .stage-art {
    filter: invert(1) hue-rotate(180deg) saturate(0.7) contrast(0.85);
    mix-blend-mode: multiply;
  }

  /* No shadow on the wrapper: every card inside a widget already carries its
     own border and Tailwind shadow, so a second shadow on the wrapper painted
     a ghost rectangle around the card plus its caption - obvious in light mode,
     where it read as a stray panel edge. */
  .zeni-widget {
    will-change: transform;
  }

</style>


