---
import { Icon } from "astro-icon/components";
---

<section id="capabilities" class="relative overflow-hidden py-20 md:py-32">
  <!-- Subtle background grid -->
  <div class="rule-grid pointer-events-none absolute inset-0 opacity-40" aria-hidden="true"></div>

  <div class="shell relative z-[2]">
    <!-- Section Header -->
    <div class="max-w-3xl">
      <div class="reveal mb-4 inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-0.5 font-mono text-[11px] text-muted shadow-xs">
        <span class="size-1.5 rounded-full bg-accent animate-pulse"></span>
        <span>What I Do</span>
      </div>

      <h2 class="reveal font-display text-[clamp(2rem,4vw,3.4rem)] font-semibold leading-[1.08] tracking-[-0.03em]">
        Three pillars of production engineering.
      </h2>
      
      <p class="reveal mt-3 max-w-[54ch] text-sm leading-relaxed text-muted md:text-base" style="--reveal-delay:120ms">
        End-to-end engineering from conversational intelligence to sub-second user surfaces and distributed event backends.
      </p>
    </div>

    <!-- 3 Alternating Feature Rows with GSAP Animated System Timelines -->
    <div class="mt-14 flex flex-col gap-16 md:mt-20 lg:gap-24">
      
      <!-- ===================================================================
           ROW 1: AI & AGENTIC SYSTEMS (RAG & Agent Execution Timeline)
           =================================================================== -->
      <article class="pillar-row grid items-center gap-8 lg:grid-cols-12 lg:gap-12" data-pillar="ai">
        <!-- Content Column (Concise & Scannable) -->
        <div class="pillar-content min-w-0 lg:col-span-5">
          <div class="inline-flex items-center gap-2 font-mono text-[11px] font-semibold tracking-wider text-accent uppercase">
            <span>01 / Intelligence &amp; Agents</span>
          </div>

          <h3 class="mt-2.5 font-display text-[clamp(1.5rem,2.5vw,2.2rem)] font-semibold leading-[1.15] tracking-[-0.025em] text-ink">
            Conversational copilots with tool orchestration.
          </h3>

          <p class="mt-3 text-sm leading-relaxed text-muted">
            Architecting production agentic workflows with streaming state, Model Context Protocol (MCP) tool routing, human-in-the-loop controls, and empirical eval assertions.
          </p>

          <ul class="mt-5 space-y-2 text-xs text-ink">
            <li class="flex items-center gap-2">
              <span class="flex size-4.5 shrink-0 items-center justify-center rounded-full bg-accent/15 text-accent">
                <Icon name="ph:check-bold" class="size-2.5" />
              </span>
              <span>Sub-200ms TTFT streaming state on Vercel <code class="font-mono text-[11px] text-accent">ai-sdk</code></span>
            </li>
            <li class="flex items-center gap-2">
              <span class="flex size-4.5 shrink-0 items-center justify-center rounded-full bg-accent/15 text-accent">
                <Icon name="ph:check-bold" class="size-2.5" />
              </span>
              <span>MCP tool routing with human-in-the-loop safeguards</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="flex size-4.5 shrink-0 items-center justify-center rounded-full bg-accent/15 text-accent">
                <Icon name="ph:check-bold" class="size-2.5" />
              </span>
              <span>84+ automated E2E eval test suites in CI release gates</span>
            </li>
          </ul>

          <div class="mt-6 flex flex-wrap gap-1.5 pt-3.5 border-t border-line/60">
            {["Vercel ai-sdk", "MCP Protocol", "RAG & Vectors", "LLM Evals", "Wasm ML"].map((tag) => (
              <span class="rounded-md border border-line bg-surface-2 px-2 py-0.5 font-mono text-[10px] text-muted">
                {tag}
              </span>
            ))}
          </div>
        </div>

        <!-- Visual Stage Column (Animated RAG & Agent Timeline) -->
        <div class="pillar-stage-wrap min-w-0 lg:col-span-7">
          <div class="interactive-stage relative w-full overflow-hidden rounded-2xl border border-line/90 bg-surface/90 p-4 shadow-xl backdrop-blur-xl sm:p-6" id="rag-stage">
            <!-- Ambient Radial Glow -->
            <div class="pointer-events-none absolute -top-10 -right-10 size-64 rounded-full bg-accent/20 blur-3xl"></div>

            <!-- Timeline Step Progress Header -->
            <div class="mb-4 flex items-center justify-between border-b border-line/60 pb-2.5 font-mono text-[10px] sm:text-[11px] overflow-hidden">
              <div class="flex items-center gap-1 sm:gap-1.5 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden py-0.5 whitespace-nowrap">
                <span class="rag-step-pill rounded px-2 py-0.5 font-bold transition-all text-accent bg-accent/15" data-step="1">1. Query</span>
                <span class="text-line-strong">&rarr;</span>
                <span class="rag-step-pill rounded px-2 py-0.5 transition-all text-muted" data-step="2">2. RAG</span>
                <span class="text-line-strong">&rarr;</span>
                <span class="rag-step-pill rounded px-2 py-0.5 transition-all text-muted" data-step="3">3. Tool</span>
                <span class="text-line-strong">&rarr;</span>
                <span class="rag-step-pill rounded px-2 py-0.5 transition-all text-muted" data-step="4">4. Stream</span>
              </div>
              <span class="hidden sm:inline-flex shrink-0 items-center gap-1.5 rounded-full bg-surface px-2 py-0.5 text-[9px] text-muted border border-line">
                <span class="size-1.5 rounded-full bg-ok animate-pulse"></span>
                <span>Live Loop</span>
              </span>
            </div>

            <!-- RAG Visual Canvas Elements -->
            <div class="space-y-2.5 font-mono text-xs">
              
              <!-- STEP 1: User Query Node -->
              <div class="rag-node rag-query rounded-xl border border-line/80 bg-bg/95 p-3 shadow-sm transition-all">
                <div class="flex items-center justify-between text-[10px] text-muted">
                  <span>&gt; Ingest Query</span>
                  <span class="rounded bg-surface-2 px-1.5 py-0.5 text-[9px]">embedding-3-small</span>
                </div>
                <p class="mt-1 font-medium text-ink text-[11px] sm:text-[12px] rag-query-text break-words">
                  "Find upstream lineage for revenue_q3 &amp; recalculate schema metrics"
                </p>
              </div>

              <!-- STEP 2: Vector Search & Chunk Retrieval Node -->
              <div class="rag-node rag-retrieval rounded-xl border border-line/80 bg-bg/95 p-3 shadow-sm transition-all">
                <div class="flex items-center justify-between text-[10px]">
                  <span class="font-semibold text-spark flex items-center gap-1.5">
                    <Icon name="ph:database-bold" class="size-3" />
                    <span>Vector DB Retrieval</span>
                  </span>
                  <span class="text-muted text-[9px]">Top-k: 2 cosine</span>
                </div>
                <div class="mt-2 grid grid-cols-1 sm:grid-cols-2 gap-2 text-[10px]">
                  <div class="rag-chunk rounded border border-spark/30 bg-spark/10 p-2 text-ink opacity-40">
                    <p class="font-bold text-spark text-[10px]">Chunk #412 (0.96 match)</p>
                    <p class="text-muted text-[9px] mt-0.5 truncate">schema_revenue_v2</p>
                  </div>
                  <div class="rag-chunk rounded border border-spark/30 bg-spark/10 p-2 text-ink opacity-40">
                    <p class="font-bold text-spark text-[10px]">Chunk #809 (0.91 match)</p>
                    <p class="text-muted text-[9px] mt-0.5 truncate">upstream_lineage_graph</p>
                  </div>
                </div>
              </div>

              <!-- STEP 3: Model & MCP Tool Execution -->
              <div class="rag-node rag-tool rounded-xl border border-line/80 bg-bg/95 p-3 shadow-sm transition-all">
                <div class="flex items-center justify-between text-[10px]">
                  <span class="font-semibold text-accent flex items-center gap-1.5">
                    <Icon name="ph:lightning-bold" class="size-3" />
                    <span>MCP Tool Execution</span>
                  </span>
                  <span class="rag-approval-badge rounded bg-ok px-1.5 py-0.5 text-[9px] font-bold text-accent-ink opacity-0 transition-opacity">
                    ✓ Approved (12ms)
                  </span>
                </div>
                <p class="mt-1 text-muted text-[10px] sm:text-[11px] rag-tool-call font-mono truncate">
                  mcp.call("query_lineage_graph", &#123; target: "revenue_q3" &#125;)
                </p>
              </div>

              <!-- STEP 4: Synthesized Streamed Response & Eval Gate -->
              <div class="rag-node rag-stream rounded-xl border border-line/80 bg-bg/95 p-3 shadow-sm transition-all">
                <div class="flex items-center justify-between text-[10px]">
                  <span class="font-semibold text-ok flex items-center gap-1.5">
                    <Icon name="ph:check-circle-bold" class="size-3" />
                    <span>Stream Output</span>
                  </span>
                  <span class="rag-eval-badge font-mono text-[9px] sm:text-[10px] text-ok font-bold opacity-0 transition-opacity">
                    84/84 Eval Passed (100%)
                  </span>
                </div>
                <p class="mt-1 text-ink text-[11px] leading-relaxed rag-stream-text opacity-40 break-words">
                  "Lineage resolved: 3 upstream transforms connected with zero schema drift. CI eval verified."
                </p>
              </div>

            </div>
          </div>
        </div>
      </article>


      <!-- ===================================================================
           ROW 2: PRODUCT UI/UX & WEB PERFORMANCE (Performance Audit Timeline)
           =================================================================== -->
      <article class="pillar-row grid items-center gap-8 lg:grid-cols-12 lg:gap-12" data-pillar="web">
        <!-- Visual Stage Column (Left) -->
        <div class="pillar-stage-wrap order-2 lg:order-1 min-w-0 lg:col-span-7">
          <div class="interactive-stage relative w-full overflow-hidden rounded-2xl border border-line/90 bg-surface/90 p-4 shadow-xl backdrop-blur-xl sm:p-6" id="perf-stage">
            <!-- Ambient Radial Glow -->
            <div class="pointer-events-none absolute -bottom-10 -left-10 size-64 rounded-full bg-spark/20 blur-3xl"></div>

            <!-- Timeline Step Progress Header -->
            <div class="mb-4 flex items-center justify-between border-b border-line/60 pb-2.5 font-mono text-[10px] sm:text-[11px] overflow-hidden">
              <div class="flex items-center gap-1 sm:gap-1.5 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden py-0.5 whitespace-nowrap">
                <span class="perf-step-pill rounded px-2 py-0.5 font-bold transition-all text-spark bg-spark/15" data-step="1">1. TTFB</span>
                <span class="text-line-strong">&rarr;</span>
                <span class="perf-step-pill rounded px-2 py-0.5 transition-all text-muted" data-step="2">2. Zero CLS</span>
                <span class="text-line-strong">&rarr;</span>
                <span class="perf-step-pill rounded px-2 py-0.5 transition-all text-muted" data-step="3">3. Sub-50ms INP</span>
                <span class="text-line-strong">&rarr;</span>
                <span class="perf-step-pill rounded px-2 py-0.5 transition-all text-muted" data-step="4">4. 100/100</span>
              </div>
            </div>

            <!-- Performance Visual Elements -->
            <div class="space-y-2.5 font-mono text-xs">
              <!-- Live Core Web Vitals Scoreboard -->
              <div class="rounded-xl border border-line/80 bg-bg/95 p-3.5 shadow-sm">
                <div class="flex items-center justify-between border-b border-line/60 pb-2">
                  <span class="font-semibold text-ink text-[11px]">Core Web Vitals Audit</span>
                  <span class="perf-lighthouse-badge rounded bg-ok/15 px-2 py-0.5 text-[9px] font-bold text-ok flex items-center gap-1">
                    <span>★</span>
                    <span class="perf-score-num">100</span><span>/100 Lighthouse</span>
                  </span>
                </div>

                <div class="mt-2.5 grid grid-cols-3 gap-2 text-center">
                  <div class="perf-gauge rounded-lg border border-ok/30 bg-ok/10 p-2">
                    <p class="font-mono text-base font-bold text-ok perf-lcp-val">0.58s</p>
                    <p class="font-mono text-[8px] text-muted">LCP (Fast)</p>
                  </div>
                  <div class="perf-gauge rounded-lg border border-ok/30 bg-ok/10 p-2">
                    <p class="font-mono text-base font-bold text-ok perf-inp-val">32ms</p>
                    <p class="font-mono text-[8px] text-muted">INP (Instant)</p>
                  </div>
                  <div class="perf-gauge rounded-lg border border-ok/30 bg-ok/10 p-2">
                    <p class="font-mono text-base font-bold text-ok">0.00</p>
                    <p class="font-mono text-[8px] text-muted">CLS (Solid)</p>
                  </div>
                </div>
              </div>

              <!-- Animated GSAP Spring Curve & Tokens -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                <div class="rounded-xl border border-line/80 bg-bg/95 p-2.5 shadow-sm">
                  <div class="flex items-center justify-between text-[9px]">
                    <span class="font-semibold text-ink">GSAP Physics Spring</span>
                    <span class="text-accent font-bold">expo.out</span>
                  </div>
                  <div class="mt-1.5 h-8 w-full rounded border border-line/60 bg-surface-2/60 p-0.5 flex items-center justify-center overflow-hidden">
                    <svg class="h-5 w-full text-accent perf-wave" viewBox="0 0 100 25" fill="none">
                      <path d="M0 20 Q 25 0, 60 4 T 100 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                    </svg>
                  </div>
                </div>

                <div class="rounded-xl border border-line/80 bg-bg/95 p-2.5 shadow-sm">
                  <div class="flex items-center justify-between text-[9px]">
                    <span class="font-semibold text-ink">Design Tokens</span>
                    <span class="text-ok font-bold">60 FPS</span>
                  </div>
                  <div class="mt-2 flex items-center gap-1.5">
                    <span class="size-3.5 rounded-full bg-accent ring-2 ring-accent/30 animate-pulse"></span>
                    <span class="size-3.5 rounded-full bg-spark ring-2 ring-spark/30 animate-pulse" style="animation-delay: 200ms"></span>
                    <span class="size-3.5 rounded-full bg-ok ring-2 ring-ok/30 animate-pulse" style="animation-delay: 400ms"></span>
                    <span class="ml-auto font-mono text-[8px] text-muted">Zero FOUC</span>
                  </div>
                </div>
              </div>
            </div>

          </div>
        </div>

        <!-- Content Column (Concise & Scannable) -->
        <div class="pillar-content order-1 lg:order-2 min-w-0 lg:col-span-5">
          <div class="inline-flex items-center gap-2 font-mono text-[11px] font-semibold tracking-wider text-accent uppercase">
            <span>02 / Experience &amp; Craft</span>
          </div>

          <h3 class="mt-2.5 font-display text-[clamp(1.5rem,2.5vw,2.2rem)] font-semibold leading-[1.15] tracking-[-0.025em] text-ink">
            Sub-second speed meets bespoke interface craft.
          </h3>

          <p class="mt-3 text-sm leading-relaxed text-muted">
            Crafting fast, accessible web surfaces with sub-second LCP and near-zero INP. Built with scalable design token systems, expressive GSAP physics, and zero layout shift.
          </p>

          <ul class="mt-5 space-y-2 text-xs text-ink">
            <li class="flex items-center gap-2">
              <span class="flex size-4.5 shrink-0 items-center justify-center rounded-full bg-accent/15 text-accent">
                <Icon name="ph:check-bold" class="size-2.5" />
              </span>
              <span>0.58s LCP &amp; 32ms INP across millions of user visits</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="flex size-4.5 shrink-0 items-center justify-center rounded-full bg-accent/15 text-accent">
                <Icon name="ph:check-bold" class="size-2.5" />
              </span>
              <span>Tokenized design systems with seamless dark/light modes</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="flex size-4.5 shrink-0 items-center justify-center rounded-full bg-accent/15 text-accent">
                <Icon name="ph:check-bold" class="size-2.5" />
              </span>
              <span>Expressive GSAP physics &amp; fluid micro-interactions</span>
            </li>
          </ul>

          <div class="mt-6 flex flex-wrap gap-1.5 pt-3.5 border-t border-line/60">
            {["Core Web Vitals", "GSAP Physics", "Design Tokens", "Astro & Next.js", "Lighthouse 100"].map((tag) => (
              <span class="rounded-md border border-line bg-surface-2 px-2 py-0.5 font-mono text-[10px] text-muted">
                {tag}
              </span>
            ))}
          </div>
        </div>
      </article>


      <!-- ===================================================================
           ROW 3: SCALABLE FULL-STACK ARCHITECTURE (Distributed Stream Timeline)
           =================================================================== -->
      <article class="pillar-row grid items-center gap-8 lg:grid-cols-12 lg:gap-12" data-pillar="fullstack">
        <!-- Content Column (Concise & Scannable) -->
        <div class="pillar-content min-w-0 lg:col-span-5">
          <div class="inline-flex items-center gap-2 font-mono text-[11px] font-semibold tracking-wider text-accent uppercase">
            <span>03 / Platform &amp; Infrastructure</span>
          </div>

          <h3 class="mt-2.5 font-display text-[clamp(1.5rem,2.5vw,2.2rem)] font-semibold leading-[1.15] tracking-[-0.025em] text-ink">
            Event-driven backends engineered for scale.
          </h3>

          <p class="mt-3 text-sm leading-relaxed text-muted">
            Engineering high-throughput distributed backends and cloud infrastructure. Kafka event pipelines, Redis caching topologies, Kubernetes orchestration, and resilient APIs.
          </p>

          <ul class="mt-5 space-y-2 text-xs text-ink">
            <li class="flex items-center gap-2">
              <span class="flex size-4.5 shrink-0 items-center justify-center rounded-full bg-accent/15 text-accent">
                <Icon name="ph:check-bold" class="size-2.5" />
              </span>
              <span>Kafka streaming processing 45,000+ events/second</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="flex size-4.5 shrink-0 items-center justify-center rounded-full bg-accent/15 text-accent">
                <Icon name="ph:check-bold" class="size-2.5" />
              </span>
              <span>Redis distributed multi-tier cache with 99.8% hit rate</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="flex size-4.5 shrink-0 items-center justify-center rounded-full bg-accent/15 text-accent">
                <Icon name="ph:check-bold" class="size-2.5" />
              </span>
              <span>Kubernetes auto-scaling clusters with 99.99% SLA</span>
            </li>
          </ul>

          <div class="mt-6 flex flex-wrap gap-1.5 pt-3.5 border-t border-line/60">
            {["Apache Kafka", "Redis Cache", "Kubernetes", "Node.js & Go", "Zero-Downtime"].map((tag) => (
              <span class="rounded-md border border-line bg-surface-2 px-2 py-0.5 font-mono text-[10px] text-muted">
                {tag}
              </span>
            ))}
          </div>
        </div>

        <!-- Visual Stage Column (Distributed Pipeline Animation) -->
        <div class="pillar-stage-wrap min-w-0 lg:col-span-7">
          <div class="interactive-stage relative w-full overflow-hidden rounded-2xl border border-line/90 bg-surface/90 p-4 shadow-xl backdrop-blur-xl sm:p-6" id="stream-stage">
            <!-- Ambient Radial Glow -->
            <div class="pointer-events-none absolute -top-10 -left-10 size-64 rounded-full bg-ok/20 blur-3xl"></div>

            <!-- Timeline Step Progress Header -->
            <div class="mb-4 flex items-center justify-between border-b border-line/60 pb-2.5 font-mono text-[10px] sm:text-[11px] overflow-hidden">
              <div class="flex items-center gap-1 sm:gap-1.5 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden py-0.5 whitespace-nowrap">
                <span class="stream-step-pill rounded px-2 py-0.5 font-bold transition-all text-ok bg-ok/15" data-step="1">1. Ingress</span>
                <span class="text-line-strong">&rarr;</span>
                <span class="stream-step-pill rounded px-2 py-0.5 transition-all text-muted" data-step="2">2. Kafka</span>
                <span class="text-line-strong">&rarr;</span>
                <span class="stream-step-pill rounded px-2 py-0.5 transition-all text-muted" data-step="3">3. Redis</span>
                <span class="text-line-strong">&rarr;</span>
                <span class="stream-step-pill rounded px-2 py-0.5 transition-all text-muted" data-step="4">4. K8s</span>
              </div>
            </div>

            <!-- Distributed Topology Visual Nodes -->
            <div class="space-y-2.5 font-mono text-xs">
              <div class="rounded-xl border border-line/80 bg-bg/95 p-3.5 shadow-sm">
                <div class="flex items-center justify-between border-b border-line/60 pb-2 text-[11px]">
                  <span class="font-semibold text-ink">Distributed Stream Stack</span>
                  <span class="text-ok font-semibold text-[9px] sm:text-[10px]">● 99.99% SLA</span>
                </div>
                <div class="mt-2.5 grid grid-cols-2 sm:grid-cols-4 gap-2 text-center font-mono text-[10px]">
                  <div class="stream-node stream-ingress rounded-lg border border-line bg-surface-2 p-1.5 transition-all">
                    <p class="font-bold text-ink stream-req-count">20M+</p>
                    <p class="text-[8px] text-muted">Ingress</p>
                  </div>
                  <div class="stream-node stream-kafka rounded-lg border border-accent/40 bg-accent/10 p-1.5 text-accent transition-all">
                    <p class="font-bold stream-msg-rate">45k/s</p>
                    <p class="text-[8px]">Kafka</p>
                  </div>
                  <div class="stream-node stream-redis rounded-lg border border-spark/40 bg-spark/10 p-1.5 text-spark transition-all">
                    <p class="font-bold">99.8%</p>
                    <p class="text-[8px]">Redis Hit</p>
                  </div>
                  <div class="stream-node stream-k8s rounded-lg border border-ok/40 bg-ok/10 p-1.5 text-ok transition-all">
                    <p class="font-bold">12 Pods</p>
                    <p class="text-[8px]">K8s Auto</p>
                  </div>
                </div>
              </div>

              <!-- Live Stream Event Ticker Feed -->
              <div class="rounded-xl border border-line/80 bg-bg/95 p-3 shadow-sm">
                <div class="flex items-center justify-between text-[9px] border-b border-line/60 pb-1.5">
                  <span class="font-semibold text-ink flex items-center gap-1">
                    <span class="size-1.5 rounded-full bg-ok animate-ping"></span>
                    <span>Live Kafka Telemetry</span>
                  </span>
                  <span class="text-muted font-mono">P95: 42ms</span>
                </div>
                <div class="mt-1.5 space-y-1 font-mono text-[9px] sm:text-[10px]">
                  <div class="stream-event-row flex items-center justify-between text-muted truncate">
                    <span class="text-ink truncate">[200 OK] POST /api/telemetry</span>
                    <span class="text-ok shrink-0 ml-2">12ms • ack:1</span>
                  </div>
                  <div class="stream-event-row flex items-center justify-between text-muted truncate">
                    <span class="text-ink truncate">[CACHE_HIT] Redis session_889</span>
                    <span class="text-spark shrink-0 ml-2">0.6ms</span>
                  </div>
                </div>
              </div>
            </div>

          </div>
        </div>
      </article>

    </div>
  </div>
</section>

<!-- GSAP Multi-Step System Timelines and 3D Interactive Parallax -->
<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (!reduce.matches) {
    // 1. Entrance choreography for the 3 rows
    const rows = gsap.utils.toArray<HTMLElement>(".pillar-row");
    rows.forEach((row, i) => {
      const content = row.querySelector(".pillar-content");
      const stage = row.querySelector(".pillar-stage-wrap");
      const isEven = i % 2 === 1;

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: row,
          start: "top 80%",
          toggleActions: "play none none reverse",
        },
      });

      const isDesktop = window.innerWidth >= 1024;

      tl.from(content, {
        x: isDesktop ? (isEven ? 35 : -35) : 0,
        y: isDesktop ? 0 : 20,
        opacity: 0,
        duration: 0.8,
        ease: "power3.out",
      }).from(
        stage,
        {
          scale: 0.95,
          y: 25,
          opacity: 0,
          duration: 0.85,
          ease: "power3.out",
        },
        "-=0.5"
      );
    });

    // =========================================================================
    // 2. STAGE 1: Looping RAG & Agent Execution Timeline
    // =========================================================================
    const ragStage = document.getElementById("rag-stage");
    if (ragStage) {
      const stepPills = ragStage.querySelectorAll<HTMLElement>(".rag-step-pill");
      const queryNode = ragStage.querySelector<HTMLElement>(".rag-query");
      const chunks = ragStage.querySelectorAll<HTMLElement>(".rag-chunk");
      const toolNode = ragStage.querySelector<HTMLElement>(".rag-tool");
      const approvalBadge = ragStage.querySelector<HTMLElement>(".rag-approval-badge");
      const streamNode = ragStage.querySelector<HTMLElement>(".rag-stream");
      const streamText = ragStage.querySelector<HTMLElement>(".rag-stream-text");
      const evalBadge = ragStage.querySelector<HTMLElement>(".rag-eval-badge");

      const updatePill = (step: number) => {
        stepPills.forEach((p) => {
          const s = parseInt(p.getAttribute("data-step") || "1", 10);
          if (s === step) {
            p.classList.add("text-accent", "bg-accent/15", "font-bold");
            p.classList.remove("text-muted");
          } else {
            p.classList.remove("text-accent", "bg-accent/15", "font-bold");
            p.classList.add("text-muted");
          }
        });
      };

      const ragLoop = gsap.timeline({ repeat: -1, repeatDelay: 2.2 });

      // STEP 1: Query Ingestion (0.0s - 1.2s)
      ragLoop
        .call(() => updatePill(1))
        .to(queryNode, {
          borderColor: "var(--c-accent)",
          boxShadow: "0 0 16px var(--c-accent-soft)",
          duration: 0.4,
        })
        .to(queryNode, {
          borderColor: "rgba(255,255,255,0.08)",
          boxShadow: "none",
          duration: 0.4,
          delay: 0.7,
        });

      // STEP 2: Vector DB Search & Chunk Retrieval (1.2s - 2.8s)
      ragLoop
        .call(() => updatePill(2))
        .fromTo(
          chunks,
          { opacity: 0.3, y: 5 },
          {
            opacity: 1,
            y: 0,
            duration: 0.45,
            stagger: 0.18,
            ease: "back.out(1.5)",
          }
        )
        .to({}, { duration: 0.8 });

      // STEP 3: MCP Tool Call & Human Approval Badge (2.8s - 4.4s)
      ragLoop
        .call(() => updatePill(3))
        .to(toolNode, {
          borderColor: "var(--c-accent)",
          backgroundColor: "rgba(139, 155, 255, 0.08)",
          duration: 0.35,
        })
        .fromTo(
          approvalBadge,
          { opacity: 0, scale: 0.7 },
          { opacity: 1, scale: 1, duration: 0.35, ease: "back.out(2)" }
        )
        .to({}, { duration: 0.8 });

      // STEP 4: Streamed Synthesis & 84/84 Eval Passed Gate (4.4s - 6.5s)
      ragLoop
        .call(() => updatePill(4))
        .to(streamNode, {
          borderColor: "var(--c-ok)",
          backgroundColor: "rgba(111, 224, 176, 0.06)",
          duration: 0.35,
        })
        .to(streamText, { opacity: 1, duration: 0.4 })
        .fromTo(
          evalBadge,
          { opacity: 0, y: -4 },
          { opacity: 1, y: 0, duration: 0.35, ease: "power2.out" }
        )
        .to({}, { duration: 1.8 }) // Hold step 4 for reading

        // Reset all nodes cleanly for seamless loop
        .to([queryNode, toolNode, streamNode], {
          borderColor: "rgba(255,255,255,0.08)",
          backgroundColor: "rgba(8, 8, 13, 0.95)",
          duration: 0.4,
        })
        .to(chunks, { opacity: 0.35, duration: 0.3 }, "<")
        .to([approvalBadge, evalBadge], { opacity: 0, duration: 0.3 }, "<")
        .to(streamText, { opacity: 0.4, duration: 0.3 }, "<");
    }

    // =========================================================================
    // 3. STAGE 2: Web Performance & UI/UX Audit Live Simulation
    // =========================================================================
    const perfStage = document.getElementById("perf-stage");
    if (perfStage) {
      const perfPills = perfStage.querySelectorAll<HTMLElement>(".perf-step-pill");
      const lcpVal = perfStage.querySelector<HTMLElement>(".perf-lcp-val");
      const inpVal = perfStage.querySelector<HTMLElement>(".perf-inp-val");
      const perfWave = perfStage.querySelector<SVGElement>(".perf-wave path");
      const badgeNum = perfStage.querySelector<HTMLElement>(".perf-score-num");

      const updatePerfPill = (step: number) => {
        perfPills.forEach((p) => {
          const s = parseInt(p.getAttribute("data-step") || "1", 10);
          if (s === step) {
            p.classList.add("text-spark", "bg-spark/15", "font-bold");
            p.classList.remove("text-muted");
          } else {
            p.classList.remove("text-spark", "bg-spark/15", "font-bold");
            p.classList.add("text-muted");
          }
        });
      };

      const perfLoop = gsap.timeline({ repeat: -1, repeatDelay: 2.0 });

      // Step 1: TTFB Ingest
      perfLoop
        .call(() => updatePerfPill(1))
        if (lcpVal) {
          perfLoop.fromTo(
            { val: 1.4 },
            { val: 0.58 },
            {
              duration: 0.8,
              ease: "power2.out",
              onUpdate: function () {
                lcpVal.textContent = this.targets()[0].val.toFixed(2) + "s";
              },
            }
          );
        }

      // Step 2: Zero CLS Render & Waveform Undulation
      perfLoop
        .call(() => updatePerfPill(2))
        if (perfWave) {
          perfLoop.to(perfWave, {
            attr: { d: "M0 15 Q 35 25, 70 8 T 100 12" },
            duration: 0.6,
            ease: "sine.inOut",
            yoyo: true,
            repeat: 1,
          });
        }

      // Step 3: Sub-50ms INP
      perfLoop
        .call(() => updatePerfPill(3))
        if (inpVal) {
          perfLoop.fromTo(
            { val: 95 },
            { val: 32 },
            {
              duration: 0.6,
              ease: "power2.out",
              onUpdate: function () {
                inpVal.textContent = Math.round(this.targets()[0].val) + "ms";
              },
            }
          );
        }

      // Step 4: 100/100 Lighthouse Audit
      perfLoop
        .call(() => updatePerfPill(4))
        if (badgeNum) {
          perfLoop.fromTo(
            { score: 92 },
            { score: 100 },
            {
              duration: 0.5,
              ease: "power1.out",
              onUpdate: function () {
                badgeNum.textContent = String(Math.round(this.targets()[0].score));
              },
            }
          );
        }
        perfLoop.to({}, { duration: 1.5 });
    }

    // =========================================================================
    // 4. STAGE 3: High-Concurrency Distributed Event Pipeline
    // =========================================================================
    const streamStage = document.getElementById("stream-stage");
    if (streamStage) {
      const streamPills = streamStage.querySelectorAll<HTMLElement>(".stream-step-pill");
      const nodes = streamStage.querySelectorAll<HTMLElement>(".stream-node");
      const tickerRows = streamStage.querySelectorAll<HTMLElement>(".stream-event-row");
      const msgRate = streamStage.querySelector<HTMLElement>(".stream-msg-rate");

      const updateStreamPill = (step: number) => {
        streamPills.forEach((p) => {
          const s = parseInt(p.getAttribute("data-step") || "1", 10);
          if (s === step) {
            p.classList.add("text-ok", "bg-ok/15", "font-bold");
            p.classList.remove("text-muted");
          } else {
            p.classList.remove("text-ok", "bg-ok/15", "font-bold");
            p.classList.add("text-muted");
          }
        });
      };

      const streamLoop = gsap.timeline({ repeat: -1, repeatDelay: 1.8 });

      // Step 1: Ingress
      streamLoop
        .call(() => updateStreamPill(1))
        .to(nodes[0], { scale: 1.05, borderColor: "var(--c-accent)", duration: 0.3 })
        .to(nodes[0], { scale: 1.0, borderColor: "rgba(255,255,255,0.08)", duration: 0.3 });

      // Step 2: Kafka Partition Ingestion
      streamLoop
        .call(() => updateStreamPill(2))
        .to(nodes[1], { scale: 1.05, borderColor: "var(--c-accent)", duration: 0.3 })
        if (msgRate) {
          streamLoop.fromTo(
            { rate: 25 },
            { rate: 45 },
            {
              duration: 0.5,
              onUpdate: function () {
                msgRate.textContent = Math.round(this.targets()[0].rate) + "k/s";
              },
            },
            "<"
          );
        }
      streamLoop.to(nodes[1], { scale: 1.0, borderColor: "rgba(139, 155, 255, 0.4)", duration: 0.3 });

      // Step 3: Redis Cache Fast-Path Hit
      streamLoop
        .call(() => updateStreamPill(3))
        .to(nodes[2], { scale: 1.05, borderColor: "var(--c-spark)", duration: 0.3 })
        .fromTo(
          tickerRows,
          { opacity: 0.3, x: -6 },
          { opacity: 1, x: 0, stagger: 0.15, duration: 0.35, ease: "power2.out" }
        )
        .to(nodes[2], { scale: 1.0, borderColor: "rgba(255, 158, 122, 0.4)", duration: 0.3 });

      // Step 4: K8s Auto-Scaling
      streamLoop
        .call(() => updateStreamPill(4))
        .to(nodes[3], { scale: 1.05, borderColor: "var(--c-ok)", duration: 0.3 })
        .to(nodes[3], { scale: 1.0, borderColor: "rgba(111, 224, 176, 0.4)", duration: 0.3 })
        .to({}, { duration: 1.6 });
    }

    // =========================================================================
    // 5. Interactive 3D Parallax Tilt for All Stages
    // =========================================================================
    const stages = document.querySelectorAll<HTMLElement>(".interactive-stage");
    stages.forEach((stg) => {
      stg.addEventListener("pointermove", (e) => {
        if (window.innerWidth < 1024) return;
        const rect = stg.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;

        gsap.to(stg, {
          rotationY: x * 6,
          rotationX: -y * 6,
          transformPerspective: 1000,
          duration: 0.4,
          ease: "power1.out",
        });
      });

      stg.addEventListener("pointerleave", () => {
        gsap.to(stg, {
          rotationY: 0,
          rotationX: 0,
          duration: 0.6,
          ease: "power2.out",
        });
      });
    });
  }
</script>
