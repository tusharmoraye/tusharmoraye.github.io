---
import { Icon } from "astro-icon/components";
import DitherTrail from "./DitherTrail.astro";
---

<section id="top" class="relative min-h-[100dvh] overflow-hidden pt-24 pb-16">
  <div class="rule-grid pointer-events-none absolute inset-0 opacity-70" aria-hidden="true"></div>
  <div
    class="pointer-events-none absolute -top-[20%] left-1/2 h-[70vh] w-[110vw] -translate-x-1/2 rounded-full blur-[120px]"
    style="background: radial-gradient(closest-side, var(--glow), transparent);"
    aria-hidden="true"
  >
  </div>

  <DitherTrail />

  <div class="shell relative z-[2] grid min-h-[calc(100dvh-10rem)] items-center gap-12 lg:grid-cols-12 lg:gap-8">
    <div id="hero-copy" class="lg:col-span-7 xl:col-span-6">
      <h1
        class="font-display text-[clamp(2.2rem,4.4vw,3.5rem)] font-semibold leading-[1.02] tracking-[-0.035em]"
      >
        <span class="line-mask" style="--line-delay:80ms"><span>Conversational AI,</span></span>
        <span class="line-mask" style="--line-delay:200ms"
          ><span class="text-accent">shipped to production.</span></span
        >
      </h1>

      <p
        class="reveal mt-7 max-w-[46ch] text-base leading-relaxed text-muted md:text-lg"
        style="--reveal-delay:520ms"
      >
        Eight years building product surfaces for AI and ML systems. Currently architecting the
        Copilot interface at Atlan.
      </p>

      <div class="reveal mt-10 flex flex-wrap items-center gap-3" style="--reveal-delay:640ms">
        <a href="#contact" class="btn btn-primary">
          Get in touch
          <Icon name="ph:arrow-up-right-bold" class="size-4" />
        </a>
        <a href="#work" class="btn btn-ghost">See the work</a>
      </div>
    </div>

    <div class="lg:col-span-5 lg:col-start-8 xl:col-start-9">
      <figure
        class="reveal relative aspect-[4/5] w-full overflow-hidden rounded-[4px] border border-line bg-surface-2"
        style="--reveal-delay:360ms"
      >
        <picture>
          <source srcset="/img/hero.webp" type="image/webp" />
          <img
            id="hero-plate"
            src="/img/hero.jpg"
            alt="The curve of the earth at night seen from orbit, city light scattered across the dark side"
            width="1000"
            height="1250"
            fetchpriority="high"
            decoding="async"
            class="plate size-full scale-[1.08] object-cover"
          />
        </picture>
        <div
          class="pointer-events-none absolute inset-0"
          style="background: linear-gradient(180deg, transparent 40%, var(--c-bg) 100%); opacity:.75;"
          aria-hidden="true"
        >
        </div>
      </figure>
    </div>
  </div>
</section>

<script>
  const copy = document.getElementById("hero-copy");
  requestAnimationFrame(() => copy?.classList.add("hero-ready"));
</script>
