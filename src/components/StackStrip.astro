---
import * as si from "simple-icons";

// Real brand marks from the simple-icons package, rendered in the page's own ink
// colour so the strip holds in both themes. No invented logos, no category labels.
const marks = [
  si.siTypescript,
  si.siReact,
  si.siNextdotjs,
  si.siVuedotjs,
  si.siNodedotjs,
  si.siPython,
  si.siWebassembly,
  si.siRedis,
  si.siApachekafka,
  si.siKubernetes,
  si.siDocker,
  si.siVercel,
];
---

<section
  aria-label="Technologies used in production"
  data-stack-strip
  class="border-y border-line bg-surface/40 overflow-hidden"
>
  <div class="shell flex flex-col gap-8 py-10 lg:flex-row lg:items-center lg:gap-14 lg:py-8">
    <p class="label-mono shrink-0">Shipped with</p>
    <ul class="grid grid-cols-4 gap-x-6 gap-y-8 sm:grid-cols-6 lg:flex lg:flex-1 lg:justify-between lg:gap-8">
      {
        marks.map((m) => (
          <li class="stack-mark flex items-center justify-center">
            <svg
              role="img"
              aria-label={m.title}
              viewBox="0 0 24 24"
              class="size-6 fill-current text-muted transition-colors duration-300 hover:text-accent"
            >
              <path d={m.path} />
            </svg>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const strip = document.querySelector<HTMLElement>("[data-stack-strip]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

  // Motion rationale: storytelling. The marks arrive scattered and settle into
  // a single row, which is the point the strip is making about the stack.
  if (strip && !reduce.matches) {
    const marks = gsap.utils.toArray<HTMLElement>(".stack-mark");
    const isMobile = window.innerWidth < 640;
    const maxOffset = isMobile ? 25 : 60;
    
    gsap.from(marks, {
      opacity: 0,
      x: () => gsap.utils.random(-maxOffset, maxOffset),
      y: () => gsap.utils.random(-25, 25),
      rotate: () => gsap.utils.random(-20, 20),
      scale: 0.8,
      duration: 0.8,
      ease: "power3.out",
      stagger: { each: 0.03, from: "random" },
      scrollTrigger: { trigger: strip, start: "top 88%", once: true },
    });
  }
</script>
