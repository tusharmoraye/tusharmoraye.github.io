---
import { Icon } from "astro-icon/components";
import { site } from "../data/site";

const links = [
  { href: "#work", label: "Work" },
  { href: "#capabilities", label: "What I do" },
  { href: "#experience", label: "Experience" },
  { href: "#stack", label: "Stack" },
];
---

<header
  id="site-nav"
  class="fixed inset-x-0 top-0 z-50 h-[68px] border-b border-transparent transition-[background-color,border-color,backdrop-filter] duration-300"
>
  <nav class="shell flex h-full items-center justify-between gap-6" aria-label="Primary">
    <a href="#top" class="group flex items-center gap-3">
      <span
        class="grid size-8 place-items-center rounded-[4px] border border-line-strong bg-surface text-accent"
      >
        <svg
          viewBox="0 0 64 64"
          class="size-5"
          fill="none"
          stroke="currentColor"
          stroke-width="7"
          aria-hidden="true"
        >
          <path d="M12 16.5H52" />
          <path d="M32 16.5V29.5" />
          <path d="M16 51.5V32.5L32 48.5L48 32.5V51.5" />
        </svg>
      </span>
      <span class="hidden text-sm font-semibold tracking-tight sm:block">
        {site.name}<span class="text-muted font-normal">, {site.role}</span>
      </span>
    </a>

    <div class="flex items-center gap-1.5">
      <ul class="mr-2 hidden items-center gap-1 lg:flex">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                class="rounded-[4px] px-3 py-2 text-[13px] font-medium text-muted transition-colors hover:text-ink"
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>

      <button
        id="theme-toggle"
        type="button"
        class="grid size-9 place-items-center rounded-[4px] border border-line text-muted transition-colors hover:border-line-strong hover:text-ink"
        aria-label="Switch colour theme"
      >
        <Icon name="ph:sun-bold" class="size-4 hidden [html[data-theme='dark']_&]:block" />
        <Icon name="ph:moon-bold" class="size-4 hidden [html[data-theme='light']_&]:block" />
      </button>

      <a
        href="#contact"
        class="btn btn-primary hidden h-9 !px-4 !py-0 !text-[13px] sm:inline-flex"
      >
        Get in touch
      </a>

      <button
        id="menu-open"
        type="button"
        class="grid size-9 place-items-center rounded-[4px] border border-line text-ink lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="ph:list-bold" class="size-4" />
      </button>
    </div>
  </nav>
</header>

<div
  id="mobile-menu"
  hidden
  class="fixed inset-0 z-[70] bg-bg/95 backdrop-blur-xl lg:hidden"
>
  <div class="shell flex h-[68px] items-center justify-end">
    <button
      id="menu-close"
      type="button"
      class="grid size-9 place-items-center rounded-[4px] border border-line text-ink"
      aria-label="Close menu"
    >
      <Icon name="ph:x-bold" class="size-4" />
    </button>
  </div>
  <ul class="shell mt-6 flex flex-col gap-1">
    {
      links.map((l) => (
        <li>
          <a
            href={l.href}
            data-menu-link
            class="block border-b border-line py-5 text-3xl font-semibold tracking-tight"
          >
            {l.label}
          </a>
        </li>
      ))
    }
    <li class="pt-6">
      <a href="#contact" data-menu-link class="btn btn-primary w-full">Get in touch</a>
    </li>
  </ul>
</div>

<script>
  const nav = document.getElementById("site-nav")!;
  const menu = document.getElementById("mobile-menu")!;
  const openBtn = document.getElementById("menu-open")!;
  const closeBtn = document.getElementById("menu-close")!;
  const toggle = document.getElementById("theme-toggle")!;

  // Nav surface appears only once the page has left the hero. State, not decoration.
  const sentinel = document.createElement("div");
  sentinel.style.cssText = "position:absolute;top:0;height:1px;width:1px;";
  document.body.prepend(sentinel);
  new IntersectionObserver(
    ([entry]) => {
      nav.classList.toggle("!border-line", !entry.isIntersecting);
      nav.classList.toggle("bg-bg/80", !entry.isIntersecting);
      nav.classList.toggle("backdrop-blur-xl", !entry.isIntersecting);
    },
    { rootMargin: "-80px 0px 0px 0px" },
  ).observe(sentinel);

  const setMenu = (open: boolean) => {
    menu.hidden = !open;
    openBtn.setAttribute("aria-expanded", String(open));
    document.documentElement.style.overflow = open ? "hidden" : "";
    if (open) closeBtn.focus();
  };
  openBtn.addEventListener("click", () => setMenu(true));
  closeBtn.addEventListener("click", () => setMenu(false));
  menu.querySelectorAll("[data-menu-link]").forEach((a) => a.addEventListener("click", () => setMenu(false)));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !menu.hidden) setMenu(false);
  });

  toggle.addEventListener("click", () => {
    const next = document.documentElement.getAttribute("data-theme") === "dark" ? "light" : "dark";
    document.documentElement.setAttribute("data-theme", next);
    try {
      localStorage.setItem("tm-theme", next);
    } catch {
      /* storage blocked, theme still applies for this visit */
    }
  });
</script>
